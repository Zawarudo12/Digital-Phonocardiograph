#include <SPI.h>
#include <SD.h>
#include <driver/i2s.h>
#include <arduinoFFT.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define I2S_NUM         I2S_NUM_0
#define SAMPLE_RATE     4000
#define BUFFER_SIZE     512
#define BUTTON_PIN      0
#define BLUE_LED_PIN    2
#define CS_PIN          5
#define RECORD_SECONDS  7
#define FFT_SIZE        512

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

#define BUZZER_PIN 15

double vReal[FFT_SIZE];
double vImag[FFT_SIZE];
arduinoFFT FFT = arduinoFFT(vReal, vImag, FFT_SIZE, SAMPLE_RATE);

File audioFile;

// Heartbeat datasets (optional for similarity analysis)
double normalDataset[10][FFT_SIZE / 2];
double abnormalDataset[10][FFT_SIZE / 2];
int normalCount = 0;
int abnormalCount = 0;

// Function declarations
void initI2S();
void recordAudio(int seconds, double* fftData);
void writeWavHeader(File file, uint32_t sampleRate, uint32_t dataSize);
void analyzeHeartbeat(double* fftData, int& bpm, bool& rhythmRegular, bool& abnormal, String& reason);
void showResultsOnOLED(int bpm, bool rhythmRegular, bool abnormal, String reason);

void setup() {
  Serial.begin(115200);

  // Init SD card
  if (!SD.begin(CS_PIN)) {
    Serial.println("Error: SD card init failed!");
    while (true);
  }
  Serial.println("SD card initialized.");

  // Init I2S
  initI2S();

  // Init OLED
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED init failed");
    for (;;);
  }
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  // Pins
  pinMode(BUTTON_PIN, INPUT_PULLUP);
  pinMode(BLUE_LED_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BLUE_LED_PIN, LOW);
  digitalWrite(BUZZER_PIN, LOW);

  Serial.println("System ready. Press button to record heartbeat.");
}

void loop() {
  static bool lastButtonState = HIGH;
  bool currentButtonState = digitalRead(BUTTON_PIN);

  if (lastButtonState == HIGH && currentButtonState == LOW) {
    classifyRecording();
  }

  lastButtonState = currentButtonState;
}

void initI2S() {
  i2s_config_t i2s_config = {
    .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_RX),
    .sample_rate = SAMPLE_RATE,
    .bits_per_sample = I2S_BITS_PER_SAMPLE_16BIT,
    .channel_format = I2S_CHANNEL_FMT_ONLY_LEFT,
    .communication_format = I2S_COMM_FORMAT_I2S_MSB,
    .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
    .dma_buf_count = 4,
    .dma_buf_len = BUFFER_SIZE,
    .use_apll = false,
    .tx_desc_auto_clear = false,
    .fixed_mclk = 0
  };

  i2s_pin_config_t pin_config = {
    .bck_io_num = 14,
    .ws_io_num = 25,
    .data_out_num = -1,
    .data_in_num = 32
  };

  i2s_driver_install(I2S_NUM, &i2s_config, 0, NULL);
  i2s_set_pin(I2S_NUM, &pin_config);
  i2s_set_clk(I2S_NUM, SAMPLE_RATE, I2S_BITS_PER_SAMPLE_16BIT, I2S_CHANNEL_MONO);
}

void classifyRecording() {
  Serial.println("Recording heartbeat...");
  digitalWrite(BLUE_LED_PIN, HIGH);

  double testFFT[FFT_SIZE / 2] = {0};

  // Analyze first to name file based on analysis
  recordAudio(RECORD_SECONDS, testFFT);
  int bpm = 0;
  bool rhythmRegular = true;
  bool abnormal = false;
  String reason = "";
  analyzeHeartbeat(testFFT, bpm, rhythmRegular, abnormal, reason);

  // Create filename based on analysis
  char fileName[50];
  String cleanReason = reason;
  cleanReason.replace(" ", "_"); // replace spaces
  if (abnormal) {
      snprintf(fileName, sizeof(fileName), "/Abnormal_BPM%d_%s.wav", bpm, cleanReason.c_str());
  } else {
      snprintf(fileName, sizeof(fileName), "/Normal_BPM%d.wav", bpm);
  }

  // Save recording to SD
  uint32_t dataSize = RECORD_SECONDS * SAMPLE_RATE * sizeof(int16_t);
  audioFile = SD.open(fileName, FILE_WRITE);
  if (!audioFile) {
      Serial.println("Error opening file.");
      digitalWrite(BLUE_LED_PIN, LOW);
      return;
  }
  writeWavHeader(audioFile, SAMPLE_RATE, dataSize);
  recordAudio(RECORD_SECONDS, testFFT); // re-record into file
  audioFile.close();
  Serial.printf("Recording saved as %s\n", fileName);

  // Display and buzzer alerts
  showResultsOnOLED(bpm, rhythmRegular, abnormal, reason);
  digitalWrite(BLUE_LED_PIN, LOW);
}

void recordAudio(int seconds, double* fftData) {
  size_t bytesRead = 0;
  int16_t buffer[BUFFER_SIZE];
  unsigned long startTime = millis();
  memset(fftData, 0, sizeof(double) * (FFT_SIZE / 2));

  while (millis() - startTime < seconds * 1000) {
    esp_err_t result = i2s_read(I2S_NUM, buffer, BUFFER_SIZE * sizeof(int16_t), &bytesRead, portMAX_DELAY);
    if (result == ESP_OK) {
      audioFile.write((uint8_t*)buffer, bytesRead);

      for (int i = 0; i < FFT_SIZE; i++) {
        if (i < bytesRead / sizeof(int16_t)) {
          vReal[i] = buffer[i];
          vImag[i] = 0;
        } else {
          vReal[i] = 0;
          vImag[i] = 0;
        }
      }

      FFT.Windowing(FFT_WIN_TYP_HAMMING, FFT_FORWARD);
      FFT.Compute(FFT_FORWARD);
      FFT.ComplexToMagnitude();

      for (int i = 0; i < FFT_SIZE / 2; i++) {
        fftData[i] += vReal[i];
      }
    }
  }

  for (int i = 0; i < FFT_SIZE / 2; i++) {
    fftData[i] /= RECORD_SECONDS;
  }
}

void analyzeHeartbeat(double* fftData, int& bpm, bool& rhythmRegular, bool& abnormal, String& reason) {
  const int lowFreqStart = 5;
  const int lowFreqEnd   = 40;
  double threshold = 50;
  int peakCount = 0;
  for (int i = lowFreqStart; i < lowFreqEnd; i++) {
    if (fftData[i] > threshold) peakCount++;
  }
  bpm = peakCount * 60 / RECORD_SECONDS;
  rhythmRegular = true;

  double lowBand = 0, midBand = 0, highBand = 0;
  for (int i = 0; i < FFT_SIZE / 2; i++) {
    double freq = (i * SAMPLE_RATE) / FFT_SIZE;
    if (freq < 80) lowBand += fftData[i];
    else if (freq < 200) midBand += fftData[i];
    else highBand += fftData[i];
  }

  double totalEnergy = lowBand + midBand + highBand;
  if (bpm < 50 || bpm > 120) {
    abnormal = true;
    reason += "Abnormal_BPM ";
  }
  if (!rhythmRegular) {
    abnormal = true;
    reason += "Irregular_Rhythm ";
  }
  if (highBand / totalEnergy > 0.3) {
    abnormal = true;
    reason += "Possible_Murmur";
  }
}

void showResultsOnOLED(int bpm, bool rhythmRegular, bool abnormal, String reason) {
  display.clearDisplay();
  display.setCursor(0, 0);
  display.print("BPM: "); display.println(bpm);
  display.print("Rhythm: "); display.println(rhythmRegular ? "Regular" : "Irregular");
  display.print("Status: "); display.println(abnormal ? "⚠ Abnormal" : "Normal");

  if (abnormal) {
    display.setCursor(0, 40);
    display.println(reason);
    tone(BUZZER_PIN, 1000, 300);
  } else {
    noTone(BUZZER_PIN);
  }

  display.display();
}

void writeWavHeader(File file, uint32_t sampleRate, uint32_t dataSize) {
  file.seek(0);
  file.write((uint8_t*)"RIFF", 4);
  uint32_t chunkSize = dataSize + 36;
  file.write((uint8_t*)&chunkSize, 4);
  file.write((uint8_t*)"WAVE", 4);
  file.write((uint8_t*)"fmt ", 4);
  uint32_t subChunk1Size = 16;
  uint16_t audioFormat = 1;
  uint16_t numChannels = 1;
  uint16_t bitsPerSample = 16;
  uint32_t byteRate = sampleRate * numChannels * bitsPerSample / 8;
  uint16_t blockAlign = numChannels * bitsPerSample / 8;
  file.write((uint8_t*)&subChunk1Size, 4);
  file.write((uint8_t*)&audioFormat, 2);
  file.write((uint8_t*)&numChannels, 2);
  file.write((uint8_t*)&sampleRate, 4);
  file.write((uint8_t*)&byteRate, 4);
  file.write((uint8_t*)&blockAlign, 2);
  file.write((uint8_t*)&bitsPerSample, 2);
  file.write((uint8_t*)"data", 4);
  file.write((uint8_t*)&dataSize, 4);
}
